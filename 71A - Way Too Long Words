#include <iostream>
#include <string>
 
using namespace std;
 
int main()
{
	int n;
	cin >> n;
	for (int i = 0; i < n; i++)
	{
		string input;
		cin >> input;
 
		if (input.length() > 10)
		{
 
			int n = input.length() - 2;
			cout << input[0] << n << input[input.length() - 1] << endl;
 
		}
		else
		{
			cout << input << endl;
		}
	}
}
